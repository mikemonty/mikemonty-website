<section class="page-hero">
  {% include "partials/breadcrumbs.njk" %}
  {% set heroTitle = heading or pageTitle or title %}
  {% set heroIntro = intro or title or description %}
  {% if eyebrow and (eyebrow | trim) != (heroTitle | trim) %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
  <h1>{{ heroTitle }}</h1>
  {% if heroIntro and (heroIntro | trim) != (heroTitle | trim) %}<p class="intro">{{ heroIntro }}</p>{% endif %}
</section>
