{% if imageGallery and imageGallery.length %}
  <div class="image-gallery" data-carousel data-lightbox-gallery aria-roledescription="carousel" aria-label="Image gallery">
    <div class="image-gallery__track" data-carousel-track>
      {% for image in imageGallery %}
        <a class="image-gallery__item" href="{{ image.src }}" data-lightbox-item data-carousel-slide aria-label="Open image {{ loop.index }} of {{ imageGallery.length }}">
          <img src="{{ image.src }}" alt="{{ image.alt or '' }}" loading="lazy">
        </a>
      {% endfor %}
    </div>
    {% if imageGallery.length > 1 %}
      <button class="image-gallery__nav image-gallery__nav--prev" type="button" data-carousel-prev aria-label="Previous image">&#8249;</button>
      <button class="image-gallery__nav image-gallery__nav--next" type="button" data-carousel-next aria-label="Next image">&#8250;</button>
      <p class="image-gallery__counter" data-carousel-counter aria-live="polite"></p>
    {% endif %}
  </div>
{% endif %}
