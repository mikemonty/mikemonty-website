{% set breadcrumbItems = breadcrumbItems or breadcrumbs %}
{% set currentLabel = breadcrumbCurrent or pageTitle or heading or title %}

{% if breadcrumbItems and currentLabel %}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    {% for crumb in breadcrumbItems %}
      <a href="{{ crumb.url }}">{{ crumb.label }}</a>
      <span class="breadcrumbs__separator" aria-hidden="true">&gt;</span>
    {% endfor %}
    <span aria-current="page">{{ currentLabel }}</span>
  </nav>
{% endif %}
