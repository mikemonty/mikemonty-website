---
layout: layouts/base.njk
---
{% set levelTutorials = collections.tutorialsSorted | collectionForLevel(level.slug) %}
{% include "partials/page-hero.njk" %}

<section class="section reading-width" aria-labelledby="tutorials-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Playlist order</p>
      <h2 id="tutorials-heading">Tutorials</h2>
    </div>
    <span class="meta">{{ levelTutorials.length }} videos</span>
  </div>
  <div class="entry-list ordered-list">
    {% for tutorial in levelTutorials %}
      <article class="entry">
        <div class="entry-header">
          <h3><a href="{{ tutorial.url }}">{{ tutorial.data.title }}</a></h3>
          <span class="status">#{{ tutorial.data.order }}</span>
        </div>
        <p>{{ tutorial.data.intro or tutorial.data.description }}</p>
      </article>
    {% endfor %}
  </div>
</section>
