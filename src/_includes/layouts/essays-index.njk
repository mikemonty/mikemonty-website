---
layout: layouts/base.njk
---
{% include "partials/page-hero.njk" %}

<section class="section reading-width" aria-labelledby="essays-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Archive</p>
      <h2 id="essays-heading">Articles</h2>
    </div>
    <span class="meta">{{ collections.essaysSorted.length }} published</span>
  </div>
  <div class="entry-list">
    {% for essay in collections.essaysSorted %}
      <article class="entry">
        <div class="entry-header">
          <h3><a href="{{ essay.url }}">{{ essay.data.title }}</a></h3>
          <span class="status"><time datetime="{{ essay.data.date | dateIso }}">{{ essay.data.date | dateDisplay }}</time></span>
        </div>
        <p>{{ essay.data.intro or essay.data.description }}</p>
      </article>
    {% endfor %}
  </div>
</section>
