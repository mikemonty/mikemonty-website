---
layout: layouts/base.njk
---
<article class="article article--video">
  <header class="article-header">
    <p class="eyebrow">Yo-Yo Video</p>
    <h1>{{ title }}</h1>
    <p class="intro">{{ section or intro }}</p>
    <p class="article-meta"><time datetime="{{ date | dateIso }}">{{ date | dateDisplay }}</time> · {{ section }} · {{ duration_text }}</p>
  </header>

  {% set videoId = youtubeId %}
  {% set videoTitle = title %}
  {% include "partials/video-embed.njk" %}

  {% if content | trim %}
    <div class="article-body section">
      {{ content | safe }}
      <p><a href="{{ youtubeUrl }}">Open this video on YouTube</a>.</p>
    </div>
  {% else %}
    <div class="article-body section">
      <p><a href="{{ youtubeUrl }}">Open this video on YouTube</a>.</p>
    </div>
  {% endif %}

  <nav class="pagination-nav" aria-label="Video navigation">
    <a href="/yoyo/videos/"><span>Back to</span>Yo-yo videos</a>
  </nav>
</article>
