<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or site.description }}">
    {% set documentTitle = pageTitle or title %}
    <title>{% if documentTitle and documentTitle != site.name %}{{ documentTitle }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
    <link rel="stylesheet" href="/assets/css/style.css?v=20260608-menu">
  </head>
  <body class="site-shell">
    {% include "partials/site-header.njk" %}

    <main class="site-main">
      {{ content | safe }}
    </main>

    {% include "partials/site-footer.njk" %}
    <script>
      (() => {
        const shell = document.querySelector(".site-shell");
        const header = document.querySelector(".site-header");
        const toggle = document.querySelector(".nav-toggle");
        const nav = document.querySelector("#site-nav");

        if (!shell || !header || !toggle || !nav) {
          return;
        }

        shell.classList.add("has-menu-toggle");

        const setOpen = (isOpen) => {
          header.dataset.navOpen = String(isOpen);
          toggle.setAttribute("aria-expanded", String(isOpen));
        };

        setOpen(false);

        toggle.addEventListener("click", () => {
          setOpen(header.dataset.navOpen !== "true");
        });

        nav.addEventListener("click", (event) => {
          if (event.target.closest("a")) {
            setOpen(false);
          }
        });
      })();
    </script>
  </body>
</html>
