---
layout: layouts/base.njk
---
<article class="article article--project">
  <header class="article-header">
    {% if not breadcrumbs %}
      {% set breadcrumbItems = [{ label: "Projects", url: "/projects/" }] %}
    {% endif %}
    {% include "partials/breadcrumbs.njk" %}
    <p class="eyebrow">{{ status or "Project" }}</p>
    <h1>{{ title }}</h1>
    <p class="intro">{{ summary or description }}</p>
  </header>

  {% include "partials/image-gallery.njk" %}

  <div class="split-panel">
    <section class="article-body">
      <h2>Summary</h2>
      {{ content | safe }}

      {% if notes %}
        <h2>Notes / changelog</h2>
        {{ notes | safe }}
      {% endif %}
    </section>

    <aside class="detail-panel">
      <h2>Status</h2>
      <p>{{ status or "In progress" }}</p>

      {% if screenshots %}
        <h2>Screenshots</h2>
        <div class="media-stack">
          {% for screenshot in screenshots %}
            <img src="{{ screenshot.src }}" alt="{{ screenshot.alt or '' }}" loading="lazy">
          {% endfor %}
        </div>
      {% endif %}

      {% if links %}
        <h2>Related links</h2>
        <ul>
          {% for link in links %}
            <li><a href="{{ link.url }}">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}
    </aside>
  </div>
</article>
